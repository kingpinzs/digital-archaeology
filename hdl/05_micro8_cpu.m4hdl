# ============================================
# Micro8 CPU - 8-bit CPU Implementation
# ============================================
# An 8-bit CPU with 8 registers, 16-bit addressing,
# Z/C/S/O flags, and interrupt support.

# ============================================
# CPU Signals
# ============================================
wire clk;
wire rst;

# ============================================
# 8-BIT ALU
# ============================================
wire [7:0] alu_a;
wire [7:0] alu_b;
wire [3:0] alu_op;    # 0=ADD,1=SUB,2=AND,3=OR,4=XOR,5=NOT,6=SHL,7=SHR
wire [7:0] alu_r;
wire alu_z;           # Zero flag
wire alu_c;           # Carry flag
wire alu_s;           # Sign flag
wire alu_o;           # Overflow flag
wire alu_cin;

# ALU B inversion for SUB
wire [7:0] alu_b_inv;
wire [7:0] alu_b_adj;
wire alu_do_sub;

not ALU_INV0 (input: alu_b[0], output: alu_b_inv[0]);
not ALU_INV1 (input: alu_b[1], output: alu_b_inv[1]);
not ALU_INV2 (input: alu_b[2], output: alu_b_inv[2]);
not ALU_INV3 (input: alu_b[3], output: alu_b_inv[3]);
not ALU_INV4 (input: alu_b[4], output: alu_b_inv[4]);
not ALU_INV5 (input: alu_b[5], output: alu_b_inv[5]);
not ALU_INV6 (input: alu_b[6], output: alu_b_inv[6]);
not ALU_INV7 (input: alu_b[7], output: alu_b_inv[7]);

# do_sub when op=SUB(1)
wire alu_op0n;
not ALU_OP0N (input: alu_op[0], output: alu_op0n);

# B_adj mux: SUB uses ~B, ADD uses B
wire alu_badj_t0_0; wire alu_badj_t0_1;
and ALU_BADJ0_0 (input: alu_b[0] alu_op0n, output: alu_badj_t0_0);
and ALU_BADJ0_1 (input: alu_b_inv[0] alu_op[0], output: alu_badj_t0_1);
or  ALU_BADJ0 (input: alu_badj_t0_0 alu_badj_t0_1, output: alu_b_adj[0]);

wire alu_badj_t1_0; wire alu_badj_t1_1;
and ALU_BADJ1_0 (input: alu_b[1] alu_op0n, output: alu_badj_t1_0);
and ALU_BADJ1_1 (input: alu_b_inv[1] alu_op[0], output: alu_badj_t1_1);
or  ALU_BADJ1 (input: alu_badj_t1_0 alu_badj_t1_1, output: alu_b_adj[1]);

wire alu_badj_t2_0; wire alu_badj_t2_1;
and ALU_BADJ2_0 (input: alu_b[2] alu_op0n, output: alu_badj_t2_0);
and ALU_BADJ2_1 (input: alu_b_inv[2] alu_op[0], output: alu_badj_t2_1);
or  ALU_BADJ2 (input: alu_badj_t2_0 alu_badj_t2_1, output: alu_b_adj[2]);

wire alu_badj_t3_0; wire alu_badj_t3_1;
and ALU_BADJ3_0 (input: alu_b[3] alu_op0n, output: alu_badj_t3_0);
and ALU_BADJ3_1 (input: alu_b_inv[3] alu_op[0], output: alu_badj_t3_1);
or  ALU_BADJ3 (input: alu_badj_t3_0 alu_badj_t3_1, output: alu_b_adj[3]);

wire alu_badj_t4_0; wire alu_badj_t4_1;
and ALU_BADJ4_0 (input: alu_b[4] alu_op0n, output: alu_badj_t4_0);
and ALU_BADJ4_1 (input: alu_b_inv[4] alu_op[0], output: alu_badj_t4_1);
or  ALU_BADJ4 (input: alu_badj_t4_0 alu_badj_t4_1, output: alu_b_adj[4]);

wire alu_badj_t5_0; wire alu_badj_t5_1;
and ALU_BADJ5_0 (input: alu_b[5] alu_op0n, output: alu_badj_t5_0);
and ALU_BADJ5_1 (input: alu_b_inv[5] alu_op[0], output: alu_badj_t5_1);
or  ALU_BADJ5 (input: alu_badj_t5_0 alu_badj_t5_1, output: alu_b_adj[5]);

wire alu_badj_t6_0; wire alu_badj_t6_1;
and ALU_BADJ6_0 (input: alu_b[6] alu_op0n, output: alu_badj_t6_0);
and ALU_BADJ6_1 (input: alu_b_inv[6] alu_op[0], output: alu_badj_t6_1);
or  ALU_BADJ6 (input: alu_badj_t6_0 alu_badj_t6_1, output: alu_b_adj[6]);

wire alu_badj_t7_0; wire alu_badj_t7_1;
and ALU_BADJ7_0 (input: alu_b[7] alu_op0n, output: alu_badj_t7_0);
and ALU_BADJ7_1 (input: alu_b_inv[7] alu_op[0], output: alu_badj_t7_1);
or  ALU_BADJ7 (input: alu_badj_t7_0 alu_badj_t7_1, output: alu_b_adj[7]);

# Carry in = op[0] for SUB
buf ALU_CIN (input: alu_op[0], output: alu_cin);

# 8-bit adder chain
wire [7:0] alu_add_r;
wire alu_c0; wire alu_c1; wire alu_c2; wire alu_c3;
wire alu_c4; wire alu_c5; wire alu_c6; wire alu_cout;

# FA0
wire alu_s0_t; wire alu_c0_t1; wire alu_c0_t2;
xor ALU_FA0_X1 (input: alu_a[0] alu_b_adj[0], output: alu_s0_t);
and ALU_FA0_A1 (input: alu_a[0] alu_b_adj[0], output: alu_c0_t1);
xor ALU_FA0_X2 (input: alu_s0_t alu_cin, output: alu_add_r[0]);
and ALU_FA0_A2 (input: alu_s0_t alu_cin, output: alu_c0_t2);
or  ALU_FA0_O1 (input: alu_c0_t1 alu_c0_t2, output: alu_c0);

# FA1
wire alu_s1_t; wire alu_c1_t1; wire alu_c1_t2;
xor ALU_FA1_X1 (input: alu_a[1] alu_b_adj[1], output: alu_s1_t);
and ALU_FA1_A1 (input: alu_a[1] alu_b_adj[1], output: alu_c1_t1);
xor ALU_FA1_X2 (input: alu_s1_t alu_c0, output: alu_add_r[1]);
and ALU_FA1_A2 (input: alu_s1_t alu_c0, output: alu_c1_t2);
or  ALU_FA1_O1 (input: alu_c1_t1 alu_c1_t2, output: alu_c1);

# FA2
wire alu_s2_t; wire alu_c2_t1; wire alu_c2_t2;
xor ALU_FA2_X1 (input: alu_a[2] alu_b_adj[2], output: alu_s2_t);
and ALU_FA2_A1 (input: alu_a[2] alu_b_adj[2], output: alu_c2_t1);
xor ALU_FA2_X2 (input: alu_s2_t alu_c1, output: alu_add_r[2]);
and ALU_FA2_A2 (input: alu_s2_t alu_c1, output: alu_c2_t2);
or  ALU_FA2_O1 (input: alu_c2_t1 alu_c2_t2, output: alu_c2);

# FA3
wire alu_s3_t; wire alu_c3_t1; wire alu_c3_t2;
xor ALU_FA3_X1 (input: alu_a[3] alu_b_adj[3], output: alu_s3_t);
and ALU_FA3_A1 (input: alu_a[3] alu_b_adj[3], output: alu_c3_t1);
xor ALU_FA3_X2 (input: alu_s3_t alu_c2, output: alu_add_r[3]);
and ALU_FA3_A2 (input: alu_s3_t alu_c2, output: alu_c3_t2);
or  ALU_FA3_O1 (input: alu_c3_t1 alu_c3_t2, output: alu_c3);

# FA4
wire alu_s4_t; wire alu_c4_t1; wire alu_c4_t2;
xor ALU_FA4_X1 (input: alu_a[4] alu_b_adj[4], output: alu_s4_t);
and ALU_FA4_A1 (input: alu_a[4] alu_b_adj[4], output: alu_c4_t1);
xor ALU_FA4_X2 (input: alu_s4_t alu_c3, output: alu_add_r[4]);
and ALU_FA4_A2 (input: alu_s4_t alu_c3, output: alu_c4_t2);
or  ALU_FA4_O1 (input: alu_c4_t1 alu_c4_t2, output: alu_c4);

# FA5
wire alu_s5_t; wire alu_c5_t1; wire alu_c5_t2;
xor ALU_FA5_X1 (input: alu_a[5] alu_b_adj[5], output: alu_s5_t);
and ALU_FA5_A1 (input: alu_a[5] alu_b_adj[5], output: alu_c5_t1);
xor ALU_FA5_X2 (input: alu_s5_t alu_c4, output: alu_add_r[5]);
and ALU_FA5_A2 (input: alu_s5_t alu_c4, output: alu_c5_t2);
or  ALU_FA5_O1 (input: alu_c5_t1 alu_c5_t2, output: alu_c5);

# FA6
wire alu_s6_t; wire alu_c6_t1; wire alu_c6_t2;
xor ALU_FA6_X1 (input: alu_a[6] alu_b_adj[6], output: alu_s6_t);
and ALU_FA6_A1 (input: alu_a[6] alu_b_adj[6], output: alu_c6_t1);
xor ALU_FA6_X2 (input: alu_s6_t alu_c5, output: alu_add_r[6]);
and ALU_FA6_A2 (input: alu_s6_t alu_c5, output: alu_c6_t2);
or  ALU_FA6_O1 (input: alu_c6_t1 alu_c6_t2, output: alu_c6);

# FA7
wire alu_s7_t; wire alu_c7_t1; wire alu_c7_t2;
xor ALU_FA7_X1 (input: alu_a[7] alu_b_adj[7], output: alu_s7_t);
and ALU_FA7_A1 (input: alu_a[7] alu_b_adj[7], output: alu_c7_t1);
xor ALU_FA7_X2 (input: alu_s7_t alu_c6, output: alu_add_r[7]);
and ALU_FA7_A2 (input: alu_s7_t alu_c6, output: alu_c7_t2);
or  ALU_FA7_O1 (input: alu_c7_t1 alu_c7_t2, output: alu_cout);

# Logic operations
wire [7:0] alu_and_r;
and ALU_AND0 (input: alu_a[0] alu_b[0], output: alu_and_r[0]);
and ALU_AND1 (input: alu_a[1] alu_b[1], output: alu_and_r[1]);
and ALU_AND2 (input: alu_a[2] alu_b[2], output: alu_and_r[2]);
and ALU_AND3 (input: alu_a[3] alu_b[3], output: alu_and_r[3]);
and ALU_AND4 (input: alu_a[4] alu_b[4], output: alu_and_r[4]);
and ALU_AND5 (input: alu_a[5] alu_b[5], output: alu_and_r[5]);
and ALU_AND6 (input: alu_a[6] alu_b[6], output: alu_and_r[6]);
and ALU_AND7 (input: alu_a[7] alu_b[7], output: alu_and_r[7]);

wire [7:0] alu_or_r;
or ALU_OR0 (input: alu_a[0] alu_b[0], output: alu_or_r[0]);
or ALU_OR1 (input: alu_a[1] alu_b[1], output: alu_or_r[1]);
or ALU_OR2 (input: alu_a[2] alu_b[2], output: alu_or_r[2]);
or ALU_OR3 (input: alu_a[3] alu_b[3], output: alu_or_r[3]);
or ALU_OR4 (input: alu_a[4] alu_b[4], output: alu_or_r[4]);
or ALU_OR5 (input: alu_a[5] alu_b[5], output: alu_or_r[5]);
or ALU_OR6 (input: alu_a[6] alu_b[6], output: alu_or_r[6]);
or ALU_OR7 (input: alu_a[7] alu_b[7], output: alu_or_r[7]);

wire [7:0] alu_xor_r;
xor ALU_XOR0 (input: alu_a[0] alu_b[0], output: alu_xor_r[0]);
xor ALU_XOR1 (input: alu_a[1] alu_b[1], output: alu_xor_r[1]);
xor ALU_XOR2 (input: alu_a[2] alu_b[2], output: alu_xor_r[2]);
xor ALU_XOR3 (input: alu_a[3] alu_b[3], output: alu_xor_r[3]);
xor ALU_XOR4 (input: alu_a[4] alu_b[4], output: alu_xor_r[4]);
xor ALU_XOR5 (input: alu_a[5] alu_b[5], output: alu_xor_r[5]);
xor ALU_XOR6 (input: alu_a[6] alu_b[6], output: alu_xor_r[6]);
xor ALU_XOR7 (input: alu_a[7] alu_b[7], output: alu_xor_r[7]);

wire [7:0] alu_not_r;
not ALU_NOT0 (input: alu_a[0], output: alu_not_r[0]);
not ALU_NOT1 (input: alu_a[1], output: alu_not_r[1]);
not ALU_NOT2 (input: alu_a[2], output: alu_not_r[2]);
not ALU_NOT3 (input: alu_a[3], output: alu_not_r[3]);
not ALU_NOT4 (input: alu_a[4], output: alu_not_r[4]);
not ALU_NOT5 (input: alu_a[5], output: alu_not_r[5]);
not ALU_NOT6 (input: alu_a[6], output: alu_not_r[6]);
not ALU_NOT7 (input: alu_a[7], output: alu_not_r[7]);

# Result is ADD/SUB result (full mux would select based on alu_op)
buf ALU_R0 (input: alu_add_r[0], output: alu_r[0]);
buf ALU_R1 (input: alu_add_r[1], output: alu_r[1]);
buf ALU_R2 (input: alu_add_r[2], output: alu_r[2]);
buf ALU_R3 (input: alu_add_r[3], output: alu_r[3]);
buf ALU_R4 (input: alu_add_r[4], output: alu_r[4]);
buf ALU_R5 (input: alu_add_r[5], output: alu_r[5]);
buf ALU_R6 (input: alu_add_r[6], output: alu_r[6]);
buf ALU_R7 (input: alu_add_r[7], output: alu_r[7]);

# Zero flag: Z = NOR(all result bits)
wire alu_z_t1; wire alu_z_t2; wire alu_z_t3; wire alu_z_t4;
or ALU_Z1 (input: alu_r[0] alu_r[1], output: alu_z_t1);
or ALU_Z2 (input: alu_r[2] alu_r[3], output: alu_z_t2);
or ALU_Z3 (input: alu_r[4] alu_r[5], output: alu_z_t3);
or ALU_Z4 (input: alu_r[6] alu_r[7], output: alu_z_t4);
wire alu_z_t5; wire alu_z_t6;
or ALU_Z5 (input: alu_z_t1 alu_z_t2, output: alu_z_t5);
or ALU_Z6 (input: alu_z_t3 alu_z_t4, output: alu_z_t6);
wire alu_z_t7;
or ALU_Z7 (input: alu_z_t5 alu_z_t6, output: alu_z_t7);
not ALU_ZFLAG (input: alu_z_t7, output: alu_z);

# Sign flag: S = result[7]
buf ALU_SFLAG (input: alu_r[7], output: alu_s);

# Carry flag
buf ALU_CFLAG (input: alu_cout, output: alu_c);

# Overflow flag: O = carry_in_to_msb XOR carry_out_of_msb
xor ALU_OFLAG (input: alu_c6 alu_cout, output: alu_o);

# ============================================
# REGISTER FILE (8 x 8-bit registers R0-R7)
# ============================================
wire [7:0] r0; wire [7:0] r1; wire [7:0] r2; wire [7:0] r3;
wire [7:0] r4; wire [7:0] r5; wire [7:0] r6; wire [7:0] r7;
wire [7:0] reg_write_data;
wire [2:0] reg_write_sel;
wire [2:0] reg_read_sel_a;
wire [2:0] reg_read_sel_b;
wire reg_write_en;

# Write decoder (3-to-8)
wire wr_sel_0; wire wr_sel_1; wire wr_sel_2; wire wr_sel_3;
wire wr_sel_4; wire wr_sel_5; wire wr_sel_6; wire wr_sel_7;
wire ws0n; wire ws1n; wire ws2n;
not WS0N (input: reg_write_sel[0], output: ws0n);
not WS1N (input: reg_write_sel[1], output: ws1n);
not WS2N (input: reg_write_sel[2], output: ws2n);

wire ws_t0; wire ws_t1; wire ws_t2; wire ws_t3;
and WS_T0 (input: ws1n ws0n, output: ws_t0);
and WS_T1 (input: ws1n reg_write_sel[0], output: ws_t1);
and WS_T2 (input: reg_write_sel[1] ws0n, output: ws_t2);
and WS_T3 (input: reg_write_sel[1] reg_write_sel[0], output: ws_t3);

and WS0 (input: ws2n ws_t0, output: wr_sel_0);
and WS1 (input: ws2n ws_t1, output: wr_sel_1);
and WS2 (input: ws2n ws_t2, output: wr_sel_2);
and WS3 (input: ws2n ws_t3, output: wr_sel_3);
and WS4 (input: reg_write_sel[2] ws_t0, output: wr_sel_4);
and WS5 (input: reg_write_sel[2] ws_t1, output: wr_sel_5);
and WS6 (input: reg_write_sel[2] ws_t2, output: wr_sel_6);
and WS7 (input: reg_write_sel[2] ws_t3, output: wr_sel_7);

# Register load enables
wire r0_load; wire r1_load; wire r2_load; wire r3_load;
wire r4_load; wire r5_load; wire r6_load; wire r7_load;
and R0_LD (input: wr_sel_0 reg_write_en, output: r0_load);
and R1_LD (input: wr_sel_1 reg_write_en, output: r1_load);
and R2_LD (input: wr_sel_2 reg_write_en, output: r2_load);
and R3_LD (input: wr_sel_3 reg_write_en, output: r3_load);
and R4_LD (input: wr_sel_4 reg_write_en, output: r4_load);
and R5_LD (input: wr_sel_5 reg_write_en, output: r5_load);
and R6_LD (input: wr_sel_6 reg_write_en, output: r6_load);
and R7_LD (input: wr_sel_7 reg_write_en, output: r7_load);

# R0 register (8 DFFs with load mux)
wire [7:0] r0_next;
wire r0_loadn;
not R0_LDN (input: r0_load, output: r0_loadn);

wire r0_h0; wire r0_n0;
and R0_H0 (input: r0[0] r0_loadn, output: r0_h0);
and R0_N0 (input: reg_write_data[0] r0_load, output: r0_n0);
or  R0_M0 (input: r0_h0 r0_n0, output: r0_next[0]);
dff R0_D0 (input: r0_next[0] clk, output: r0[0]);

wire r0_h1; wire r0_n1;
and R0_H1 (input: r0[1] r0_loadn, output: r0_h1);
and R0_N1 (input: reg_write_data[1] r0_load, output: r0_n1);
or  R0_M1 (input: r0_h1 r0_n1, output: r0_next[1]);
dff R0_D1 (input: r0_next[1] clk, output: r0[1]);

wire r0_h2; wire r0_n2;
and R0_H2 (input: r0[2] r0_loadn, output: r0_h2);
and R0_N2 (input: reg_write_data[2] r0_load, output: r0_n2);
or  R0_M2 (input: r0_h2 r0_n2, output: r0_next[2]);
dff R0_D2 (input: r0_next[2] clk, output: r0[2]);

wire r0_h3; wire r0_n3;
and R0_H3 (input: r0[3] r0_loadn, output: r0_h3);
and R0_N3 (input: reg_write_data[3] r0_load, output: r0_n3);
or  R0_M3 (input: r0_h3 r0_n3, output: r0_next[3]);
dff R0_D3 (input: r0_next[3] clk, output: r0[3]);

wire r0_h4; wire r0_n4;
and R0_H4 (input: r0[4] r0_loadn, output: r0_h4);
and R0_N4 (input: reg_write_data[4] r0_load, output: r0_n4);
or  R0_M4 (input: r0_h4 r0_n4, output: r0_next[4]);
dff R0_D4 (input: r0_next[4] clk, output: r0[4]);

wire r0_h5; wire r0_n5;
and R0_H5 (input: r0[5] r0_loadn, output: r0_h5);
and R0_N5 (input: reg_write_data[5] r0_load, output: r0_n5);
or  R0_M5 (input: r0_h5 r0_n5, output: r0_next[5]);
dff R0_D5 (input: r0_next[5] clk, output: r0[5]);

wire r0_h6; wire r0_n6;
and R0_H6 (input: r0[6] r0_loadn, output: r0_h6);
and R0_N6 (input: reg_write_data[6] r0_load, output: r0_n6);
or  R0_M6 (input: r0_h6 r0_n6, output: r0_next[6]);
dff R0_D6 (input: r0_next[6] clk, output: r0[6]);

wire r0_h7; wire r0_n7;
and R0_H7 (input: r0[7] r0_loadn, output: r0_h7);
and R0_N7 (input: reg_write_data[7] r0_load, output: r0_n7);
or  R0_M7 (input: r0_h7 r0_n7, output: r0_next[7]);
dff R0_D7 (input: r0_next[7] clk, output: r0[7]);

# R1-R7 use same pattern (abbreviated for space)
wire [7:0] r1_next; wire r1_loadn;
not R1_LDN (input: r1_load, output: r1_loadn);
wire r1_h0; wire r1_n0;
and R1_H0 (input: r1[0] r1_loadn, output: r1_h0);
and R1_N0 (input: reg_write_data[0] r1_load, output: r1_n0);
or  R1_M0 (input: r1_h0 r1_n0, output: r1_next[0]);
dff R1_D0 (input: r1_next[0] clk, output: r1[0]);
wire r1_h1; wire r1_n1;
and R1_H1 (input: r1[1] r1_loadn, output: r1_h1);
and R1_N1 (input: reg_write_data[1] r1_load, output: r1_n1);
or  R1_M1 (input: r1_h1 r1_n1, output: r1_next[1]);
