# ============================================
# 16-BIT PROGRAM COUNTER
# ============================================
wire [15:0] pc;
wire [15:0] pc_next;
wire pc_load;
wire pc_inc;
wire [15:0] pc_load_val;

# PC incrementer (16-bit)
wire [15:0] pc_plus1;
wire pc_inc_c0; wire pc_inc_c1; wire pc_inc_c2; wire pc_inc_c3;
wire pc_inc_c4; wire pc_inc_c5; wire pc_inc_c6; wire pc_inc_c7;
wire pc_inc_c8; wire pc_inc_c9; wire pc_inc_c10; wire pc_inc_c11;
wire pc_inc_c12; wire pc_inc_c13; wire pc_inc_c14;

# Bit 0: just invert
not PC_INC0 (input: pc[0], output: pc_plus1[0]);
buf PC_INC_C0 (input: pc[0], output: pc_inc_c0);

# Bits 1-15: half-adder chain
xor PC_INC1 (input: pc[1] pc_inc_c0, output: pc_plus1[1]);
and PC_INC_C1 (input: pc[1] pc_inc_c0, output: pc_inc_c1);

xor PC_INC2 (input: pc[2] pc_inc_c1, output: pc_plus1[2]);
and PC_INC_C2 (input: pc[2] pc_inc_c1, output: pc_inc_c2);

xor PC_INC3 (input: pc[3] pc_inc_c2, output: pc_plus1[3]);
and PC_INC_C3 (input: pc[3] pc_inc_c2, output: pc_inc_c3);

xor PC_INC4 (input: pc[4] pc_inc_c3, output: pc_plus1[4]);
and PC_INC_C4 (input: pc[4] pc_inc_c3, output: pc_inc_c4);

xor PC_INC5 (input: pc[5] pc_inc_c4, output: pc_plus1[5]);
and PC_INC_C5 (input: pc[5] pc_inc_c4, output: pc_inc_c5);

xor PC_INC6 (input: pc[6] pc_inc_c5, output: pc_plus1[6]);
and PC_INC_C6 (input: pc[6] pc_inc_c5, output: pc_inc_c6);

xor PC_INC7 (input: pc[7] pc_inc_c6, output: pc_plus1[7]);
and PC_INC_C7 (input: pc[7] pc_inc_c6, output: pc_inc_c7);

xor PC_INC8 (input: pc[8] pc_inc_c7, output: pc_plus1[8]);
and PC_INC_C8 (input: pc[8] pc_inc_c7, output: pc_inc_c8);

xor PC_INC9 (input: pc[9] pc_inc_c8, output: pc_plus1[9]);
and PC_INC_C9 (input: pc[9] pc_inc_c8, output: pc_inc_c9);

xor PC_INC10 (input: pc[10] pc_inc_c9, output: pc_plus1[10]);
and PC_INC_C10 (input: pc[10] pc_inc_c9, output: pc_inc_c10);

xor PC_INC11 (input: pc[11] pc_inc_c10, output: pc_plus1[11]);
and PC_INC_C11 (input: pc[11] pc_inc_c10, output: pc_inc_c11);

xor PC_INC12 (input: pc[12] pc_inc_c11, output: pc_plus1[12]);
and PC_INC_C12 (input: pc[12] pc_inc_c11, output: pc_inc_c12);

xor PC_INC13 (input: pc[13] pc_inc_c12, output: pc_plus1[13]);
and PC_INC_C13 (input: pc[13] pc_inc_c12, output: pc_inc_c13);

xor PC_INC14 (input: pc[14] pc_inc_c13, output: pc_plus1[14]);
and PC_INC_C14 (input: pc[14] pc_inc_c13, output: pc_inc_c14);

xor PC_INC15 (input: pc[15] pc_inc_c14, output: pc_plus1[15]);

# PC DFFs (simplified - would need full mux logic)
dff PC_D0 (input: pc_next[0] clk, output: pc[0]);
dff PC_D1 (input: pc_next[1] clk, output: pc[1]);
dff PC_D2 (input: pc_next[2] clk, output: pc[2]);
dff PC_D3 (input: pc_next[3] clk, output: pc[3]);
dff PC_D4 (input: pc_next[4] clk, output: pc[4]);
dff PC_D5 (input: pc_next[5] clk, output: pc[5]);
dff PC_D6 (input: pc_next[6] clk, output: pc[6]);
dff PC_D7 (input: pc_next[7] clk, output: pc[7]);
dff PC_D8 (input: pc_next[8] clk, output: pc[8]);
dff PC_D9 (input: pc_next[9] clk, output: pc[9]);
dff PC_D10 (input: pc_next[10] clk, output: pc[10]);
dff PC_D11 (input: pc_next[11] clk, output: pc[11]);
dff PC_D12 (input: pc_next[12] clk, output: pc[12]);
dff PC_D13 (input: pc_next[13] clk, output: pc[13]);
dff PC_D14 (input: pc_next[14] clk, output: pc[14]);
dff PC_D15 (input: pc_next[15] clk, output: pc[15]);

# ============================================
# 16-BIT STACK POINTER
# ============================================
wire [15:0] sp;
wire [15:0] sp_next;
wire sp_load;
wire sp_inc;
wire sp_dec;

# SP DFFs
dff SP_D0 (input: sp_next[0] clk, output: sp[0]);
dff SP_D1 (input: sp_next[1] clk, output: sp[1]);
dff SP_D2 (input: sp_next[2] clk, output: sp[2]);
dff SP_D3 (input: sp_next[3] clk, output: sp[3]);
dff SP_D4 (input: sp_next[4] clk, output: sp[4]);
dff SP_D5 (input: sp_next[5] clk, output: sp[5]);
dff SP_D6 (input: sp_next[6] clk, output: sp[6]);
dff SP_D7 (input: sp_next[7] clk, output: sp[7]);
dff SP_D8 (input: sp_next[8] clk, output: sp[8]);
dff SP_D9 (input: sp_next[9] clk, output: sp[9]);
dff SP_D10 (input: sp_next[10] clk, output: sp[10]);
dff SP_D11 (input: sp_next[11] clk, output: sp[11]);
dff SP_D12 (input: sp_next[12] clk, output: sp[12]);
dff SP_D13 (input: sp_next[13] clk, output: sp[13]);
dff SP_D14 (input: sp_next[14] clk, output: sp[14]);
dff SP_D15 (input: sp_next[15] clk, output: sp[15]);

# ============================================
# FLAGS REGISTER
# ============================================
wire flag_z;    # Zero
wire flag_c;    # Carry
wire flag_s;    # Sign
wire flag_o;    # Overflow
wire flag_ie;   # Interrupt enable
wire flags_load;

dff FLAG_Z_DFF (input: alu_z clk, output: flag_z);
dff FLAG_C_DFF (input: alu_c clk, output: flag_c);
dff FLAG_S_DFF (input: alu_s clk, output: flag_s);
dff FLAG_O_DFF (input: alu_o clk, output: flag_o);

# ============================================
# INSTRUCTION REGISTER (8-bit opcode)
# ============================================
wire [7:0] ir;
wire [7:0] ir_next;
wire ir_load;

dff IR_D0 (input: ir_next[0] clk, output: ir[0]);
dff IR_D1 (input: ir_next[1] clk, output: ir[1]);
dff IR_D2 (input: ir_next[2] clk, output: ir[2]);
dff IR_D3 (input: ir_next[3] clk, output: ir[3]);
dff IR_D4 (input: ir_next[4] clk, output: ir[4]);
dff IR_D5 (input: ir_next[5] clk, output: ir[5]);
dff IR_D6 (input: ir_next[6] clk, output: ir[6]);
dff IR_D7 (input: ir_next[7] clk, output: ir[7]);

# ============================================
# OPERAND REGISTERS (for multi-byte instructions)
# ============================================
wire [7:0] operand_lo;
wire [7:0] operand_hi;
wire operand_lo_load;
wire operand_hi_load;

dff OPL_D0 (input: mem_data_in[0] clk, output: operand_lo[0]);
dff OPL_D1 (input: mem_data_in[1] clk, output: operand_lo[1]);
dff OPL_D2 (input: mem_data_in[2] clk, output: operand_lo[2]);
dff OPL_D3 (input: mem_data_in[3] clk, output: operand_lo[3]);
dff OPL_D4 (input: mem_data_in[4] clk, output: operand_lo[4]);
dff OPL_D5 (input: mem_data_in[5] clk, output: operand_lo[5]);
dff OPL_D6 (input: mem_data_in[6] clk, output: operand_lo[6]);
dff OPL_D7 (input: mem_data_in[7] clk, output: operand_lo[7]);

dff OPH_D0 (input: mem_data_in[0] clk, output: operand_hi[0]);
dff OPH_D1 (input: mem_data_in[1] clk, output: operand_hi[1]);
dff OPH_D2 (input: mem_data_in[2] clk, output: operand_hi[2]);
dff OPH_D3 (input: mem_data_in[3] clk, output: operand_hi[3]);
dff OPH_D4 (input: mem_data_in[4] clk, output: operand_hi[4]);
dff OPH_D5 (input: mem_data_in[5] clk, output: operand_hi[5]);
dff OPH_D6 (input: mem_data_in[6] clk, output: operand_hi[6]);
dff OPH_D7 (input: mem_data_in[7] clk, output: operand_hi[7]);

# ============================================
# MEMORY INTERFACE
# ============================================
wire [15:0] mem_addr;
wire [7:0] mem_data_in;
wire [7:0] mem_data_out;
wire mem_read;
wire mem_write;

# ============================================
# INSTRUCTION DECODER
# ============================================
# Decode opcode to instruction type
wire is_nop;    # 0x00
wire is_hlt;    # 0x01
wire is_mov;    # 0x40-0x7F (bits 7:6 = 01)
wire is_ldi;    # 0x06-0x0D
wire is_add;    # 0x40-0x47
wire is_sub;    # 0x50-0x57
wire is_inc;    # 0x70-0x77
wire is_dec;    # 0x78-0x7F
wire is_and;    # 0xA0-0xA7
wire is_or;     # 0xA8-0xAF
wire is_xor;    # 0xB0-0xB7
wire is_not;    # 0xB8-0xBF
wire is_jmp;    # 0xC0
wire is_jz;     # 0xC2
wire is_jnz;    # 0xC3
wire is_call;   # 0xCF
wire is_ret;    # 0xD0
wire is_push;   # 0xD2-0xD9
wire is_pop;    # 0xDA-0xE1

# NOP: 0x00 = 00000000
wire ir0n; wire ir1n; wire ir2n; wire ir3n;
wire ir4n; wire ir5n; wire ir6n; wire ir7n;
not IR0N (input: ir[0], output: ir0n);
not IR1N (input: ir[1], output: ir1n);
not IR2N (input: ir[2], output: ir2n);
not IR3N (input: ir[3], output: ir3n);
not IR4N (input: ir[4], output: ir4n);
not IR5N (input: ir[5], output: ir5n);
not IR6N (input: ir[6], output: ir6n);
not IR7N (input: ir[7], output: ir7n);

wire nop_t1; wire nop_t2; wire nop_t3;
and NOP_T1 (input: ir7n ir6n, output: nop_t1);
and NOP_T2 (input: ir5n ir4n, output: nop_t2);
and NOP_T3 (input: ir3n ir2n, output: nop_t3);
wire nop_t4; wire nop_t5;
and NOP_T4 (input: ir1n ir0n, output: nop_t4);
and NOP_T5 (input: nop_t1 nop_t2, output: nop_t5);
wire nop_t6;
and NOP_T6 (input: nop_t3 nop_t4, output: nop_t6);
and IS_NOP (input: nop_t5 nop_t6, output: is_nop);

# HLT: 0x01 = 00000001
wire hlt_t1;
and HLT_T1 (input: nop_t5 nop_t3, output: hlt_t1);
wire hlt_t2;
and HLT_T2 (input: ir1n ir[0], output: hlt_t2);
and IS_HLT (input: hlt_t1 hlt_t2, output: is_hlt);

# MOV: bits 7:6 = 01 (0x40-0x7F)
and IS_MOV (input: ir7n ir[6], output: is_mov);

# JMP: 0xC0 = 11000000
wire jmp_t1;
and JMP_T1 (input: ir[7] ir[6], output: jmp_t1);
wire jmp_t2;
and JMP_T2 (input: ir5n ir4n, output: jmp_t2);
wire jmp_t3;
and JMP_T3 (input: jmp_t1 jmp_t2, output: jmp_t3);
and IS_JMP (input: jmp_t3 nop_t6, output: is_jmp);

# ============================================
# CONTROL UNIT STATE MACHINE
# ============================================
# States:
#   000 = FETCH1: MAR <- PC, read mem
#   001 = FETCH2: IR <- mem, PC++
#   010 = DECODE: decode opcode
#   011 = FETCH_OP1: fetch operand byte 1
#   100 = FETCH_OP2: fetch operand byte 2
#   101 = EXECUTE: execute instruction
#   110 = WRITEBACK: write results
#   111 = HALT: stopped

wire [2:0] state;
wire [2:0] state_next;

dff STATE_D0 (input: state_next[0] clk, output: state[0]);
dff STATE_D1 (input: state_next[1] clk, output: state[1]);
dff STATE_D2 (input: state_next[2] clk, output: state[2]);

# State decode
wire st0n; wire st1n; wire st2n;
not ST0N (input: state[0], output: st0n);
not ST1N (input: state[1], output: st1n);
not ST2N (input: state[2], output: st2n);

wire is_fetch1; wire is_fetch2; wire is_decode;
wire is_fetch_op1; wire is_fetch_op2; wire is_execute;
wire is_writeback; wire is_halt_state;

wire st_t1; wire st_t2;
and ST_T1 (input: st2n st1n, output: st_t1);
and ST_T2 (input: st2n state[1], output: st_t2);
wire st_t3; wire st_t4;
and ST_T3 (input: state[2] st1n, output: st_t3);
and ST_T4 (input: state[2] state[1], output: st_t4);

and IS_FETCH1 (input: st_t1 st0n, output: is_fetch1);
and IS_FETCH2 (input: st_t1 state[0], output: is_fetch2);
and IS_DECODE (input: st_t2 st0n, output: is_decode);
and IS_FETCH_OP1 (input: st_t2 state[0], output: is_fetch_op1);
and IS_FETCH_OP2 (input: st_t3 st0n, output: is_fetch_op2);
and IS_EXECUTE (input: st_t3 state[0], output: is_execute);
and IS_WRITEBACK (input: st_t4 st0n, output: is_writeback);
and IS_HALT_STATE (input: st_t4 state[0], output: is_halt_state);

# ============================================
# INTERRUPT LOGIC
# ============================================
wire int_req;      # External interrupt request
wire int_ack;      # Interrupt acknowledge
wire ie_flag;      # Interrupt enable flag
wire ie_next;

dff IE_DFF (input: ie_next clk, output: ie_flag);

# Interrupt pending when request and enabled
wire int_pending;
and INT_PEND (input: int_req ie_flag, output: int_pending);

# ============================================
# CONTROL SIGNALS (generated by control unit)
# ============================================
wire halt;
wire alu_to_reg;
wire mem_to_reg;
wire imm_to_reg;

# ============================================
# SUMMARY
# ============================================
# Total estimated gates: ~2500
# - 8-bit ALU: ~400 gates
# - Register file (8x8): ~640 gates
# - 16-bit PC: ~200 gates
# - 16-bit SP: ~200 gates
# - Instruction decoder: ~300 gates
# - Control state machine: ~500 gates
# - Memory interface: ~150 gates
# - Interrupt logic: ~100 gates
